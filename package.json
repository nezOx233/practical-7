{
  "name": "practical7-75",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Практична №7 (75 балів): CI і delivery одного Node.js-сервісу",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest:ci": "node -e \"require('node:fs').mkdirSync('reports', {recursive:true})\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "start:dist": "node dist/src/server.mjs"
  }
}
